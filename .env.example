# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Ixtiyoriy: Instagram cookies fayli (Netscape formatda). Yopiq akkauntlar, story'lar
# yoki Instagram "login required / rate-limit" xatosi berganda kerak bo'ladi.
# Loyiha papkasiga cookies.txt qo'ysangiz avtomatik topiladi.
# COOKIES_FILE=cookies.txt

# Ixtiyoriy: Local Bot API server (https://github.com/tdlib/telegram-bot-api).
# Oddiy Bot API 50 MB gacha fayl yuboradi, local server esa 2000 MB gacha — 4K uchun tavsiya etiladi.
# BOT_API_ROOT=http://localhost:8081
# MAX_UPLOAD_MB=50

# Bir vaqtda nechta video qayta ishlanadi (4K upscale CPU ni ko'p yeydi)
MAX_CONCURRENT_JOBS=2

# libx264 preset: ultrafast, superfast, veryfast, faster, fast, medium, slow
FFMPEG_PRESET=medium

# Ishga tushganda yt-dlp ni yangilash (Instagram tez-tez o'zgaradi, tavsiya etiladi)
YTDLP_AUTO_UPDATE=true

# Ixtiyoriy: o'zingizning ffmpeg / yt-dlp yo'lingiz
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# YTDLP_PATH=C:\tools\yt-dlp.exe
